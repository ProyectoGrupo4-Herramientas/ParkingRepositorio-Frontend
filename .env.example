# URL del gateway de ParkControl que consume el frontend.
# Por defecto (sin este .env) ya usa el gateway desplegado en Render, que a su vez
# consume la API de CondoSaaS y la base de datos compartida. Por eso el frontend
# funciona SOLO, sin levantar el backend ni CondoSaaS.
# Copia este archivo a .env solo si corres el gateway en tu máquina:
VITE_GATEWAY_URL=https://parkingrepositorio-backend.onrender.com
